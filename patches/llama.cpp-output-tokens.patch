+// [LONGYAN]
+bool llama_model_set_output_tokens(llama_model * model, const llama_token * tokens, int32_t n_tokens) {
+    model->output_keep = nullptr;
+    model->output_norm_keep = nullptr;
+    model->output_keep_ids.clear();
+    model->output_keep_buf.reset();
+    model->output_keep_ctx.reset();
+    if (n_tokens <= 0) {
+        return true;
+    }
+    // only this architecture's graph uses the kept rows
+    if (model->arch != LLM_ARCH_QWEN35) {
+        return false;
+    }
+    ggml_tensor * out = model->output;
+    if (out == nullptr || out->buffer == nullptr || ggml_n_dims(out) != 2 || model->output_s != nullptr || model->output_b != nullptr) {
+        return false;
+    }
+    const int64_t n_vocab = out->ne[1];
+    const size_t  row     = out->nb[1];
+    for (int32_t i = 0; i < n_tokens; i++) {
+        if (tokens[i] < 0 || tokens[i] >= n_vocab) {
+            return false;
+        }
+    }
+    ggml_init_params params = { 4*ggml_tensor_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        return false;
+    }
+    std::shared_ptr<ggml_context> ctx_ptr(ctx, ggml_free);
+    ggml_tensor * t = ggml_new_tensor_2d(ctx, out->type, out->ne[0], n_tokens);
+    ggml_set_name(t, "output_keep.weight");
+    // the final norm sits just before the word table in the file; loaded on the CPU side with it,
+    // it gets a GPU copy too, so the last step doesn't hop to the CPU and back
+    ggml_tensor * norm = model->output_norm;
+    ggml_tensor * norm_keep = nullptr;
+    if (norm != nullptr && norm->buffer != nullptr && ggml_backend_buffer_is_host(norm->buffer)) {
+        norm_keep = ggml_dup_tensor(ctx, norm);
+        ggml_set_name(norm_keep, "output_norm_keep.weight");
+    }
+    // the kept rows go in the GPU's own memory, even when the full table was loaded on the CPU side
+    // (kept out of the GPU's mapped, wired range, so that its unused rows are never resident)
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(out->buffer);
+    if (ggml_backend_dev_t gpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)) {
+        buft = ggml_backend_dev_buffer_type(gpu);
+    } else if (ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft)) {
+        buft = ggml_backend_dev_buffer_type(dev);
+    }
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    if (buf == nullptr) {
+        return false;
+    }
+    std::shared_ptr<ggml_backend_buffer> buf_ptr(buf, ggml_backend_buffer_free);
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    // copied a few MB at a time, so the copy doesn't double the table's memory while it's made
+    const int32_t chunk = (int32_t) std::max<size_t>(1, (8u << 20) / row);
+    std::vector<uint8_t> rows(row * (size_t) std::min(chunk, n_tokens));
+    for (int32_t i0 = 0; i0 < n_tokens; i0 += chunk) {
+        const int32_t n = std::min(chunk, n_tokens - i0);
+        for (int32_t i = 0; i < n; i++) {
+            ggml_backend_tensor_get(out, rows.data() + row*i, row*(size_t) tokens[i0 + i], row);
+        }
+        ggml_backend_tensor_set(t, rows.data(), row*(size_t) i0, row*(size_t) n);
+    }
+    if (norm_keep != nullptr) {
+        std::vector<uint8_t> w(ggml_nbytes(norm));
+        ggml_backend_tensor_get(norm, w.data(), 0, w.size());
+        ggml_backend_tensor_set(norm_keep, w.data(), 0, w.size());
+    }
+    // the full table is read no more (only the input side looks up a few rows of it, when the
+    // weights are shared): its pages, mapped from the file, can go back to the system
+    if (out->data != nullptr && ggml_backend_buffer_is_host(out->buffer)) {
+        const uintptr_t page  = (uintptr_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t begin = ((uintptr_t) out->data + page - 1) & ~(page - 1);
+        const uintptr_t end   = ((uintptr_t) out->data + ggml_nbytes(out)) & ~(page - 1);
+        if (end > begin) {
+            // MS_INVALIDATE, not madvise: macOS keeps a file mapping's pages after MADV_DONTNEED
+            msync((void *) begin, end - begin, MS_INVALIDATE);
+        }
+    }
+    model->output_keep     = t;
+    model->output_norm_keep = norm_keep;
+    model->output_keep_ids.assign(tokens, tokens + n_tokens);
+    model->output_keep_ctx = ctx_ptr;
+    model->output_keep_buf = buf_ptr;
+    return true;
+}
