<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bridge check from C#, as the app calls the bridge (Tests/bridge/check.c is the Mac's):
       prints each lookup's last card, to compare with scripts/bridge-check-expected.txt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Longyan</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LongyanReader/Native.cs" />
  </ItemGroup>
</Project>
