<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows 10 without a Windows 10 PC (windows.yml's app job): the build gates in
       LongyanReader/WindowsBuild.cs, every icon glyph the app uses against Segoe MDL2 Assets
       (Windows 10's icon font), and the installer's oldest Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Longyan</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LongyanReader/WindowsBuild.cs" />
  </ItemGroup>
</Project>
