<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the card's springs (LongyanReader/Spring.cs) against SwiftUI's: a spring given a new
       target mid-way carries on at its speed. No WPF, so it runs anywhere dotnet does. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Longyan</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LongyanReader/Spring.cs" />
    <None Include="mac-retarget.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
